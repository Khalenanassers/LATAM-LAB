        <div style={{background:C.bg2,borderRadius:8,padding:14,marginBottom:10}}>
          <div style={{fontSize:12,fontWeight:600,marginBottom:4}}>Four-Model Comparison</div>
          <div style={{fontSize:10,color:C.sub,marginBottom:8,fontStyle:"italic"}}>In-sample on 22 real months (excl. 2 backfilled). OOS from rolling-origin CV (12 forecasts).</div>
          <div style={{overflowX:"auto"}}>
            <table style={{width:"100%",borderCollapse:"collapse",fontSize:11,minWidth:480}}>
              <thead><tr style={{borderBottom:`1px solid ${C.grid}`}}>
                <th style={{textAlign:"left",padding:"5px 8px",color:C.sub}}>Metric</th>
                {models.map(m=><th key={m.key} style={{textAlign:"right",padding:"5px 8px",color:m.color}}>{m.label}</th>)}
              </tr></thead>
              <tbody>
                {[
                  ["MAE (in-sample)",m=>m.mae],
                  ["MAE (out-of-sample)",m=>m.oos_mae],
                  ["R²",m=>m.r2],
                  ["F1 (crisis)",m=>m.f1],
                  ["Recall",m=>m.recall],["Precision",m=>m.precision],
                  ["Crisis-Month Bias",m=>m.crisis_bias],
                ].map(([label,fn],i)=>(
                  <tr key={i} style={{borderBottom:`1px solid ${C.grid}`}}>
                    <td style={{padding:"5px 8px",color:C.sub}}>{label}</td>
                    {models.map(m=>(
                      <td key={m.key} style={{textAlign:"right",padding:"5px 8px",color:m.color,fontWeight:600}}>{fn(m)}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Confusion matrices — 4 across */}
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(190px,1fr))",gap:8,marginBottom:10}}>
          {models.map(m=><ConfusionMatrix key={m.key} m={m}/>)}
        </div>

        {/* Fitted + forecast chart */}
        <div style={{background:C.bg2,borderRadius:8,padding:14,marginBottom:10}}>
          <div style={{fontSize:11,fontWeight:600,marginBottom:8}}>In-Sample Fit + 3-Month Forecast (Jan–Mar 2027)</div>
          <ResponsiveContainer width="100%" height={280}>
            <ComposedChart data={series}>
              <CartesianGrid stroke={C.grid} vertical={false}/>
              <XAxis dataKey="date" tick={{fill:C.sub,fontSize:9}} interval={3}/>
              <YAxis tick={{fill:C.sub,fontSize:9}} tickFormatter={fmt}/>
              <Tooltip content={<CustomTooltip/>}/>
              <Line type="monotone" dataKey="netCash" stroke={C.text} strokeWidth={2} dot={{r:2}} name="Observed" opacity={0.9}/>
              <Line type="monotone" dataKey="fourierFit" stroke="#F472B6" strokeWidth={1.5} dot={false} strokeDasharray="3 2" name="Fourier fit"/>
              <Line type="monotone" dataKey="lagFit" stroke={C.blue} strokeWidth={1.5} dot={false} strokeDasharray="3 2" name="Business Logic fit"/>
              <Line type="monotone" dataKey="fourierFit" stroke="#F472B6" strokeWidth={1.5} dot={false} strokeDasharray="3 2" name="Fourier fit"/>
              <Line type="monotone" dataKey="prophetFit" stroke={C.teal} strokeWidth={1.5} dot={false} strokeDasharray="3 2" name="Prophet fit"/>
              <Line type="monotone" dataKey="fourierFc" stroke="#F472B6" strokeWidth={2.5} dot={{r:4,fill:"#F472B6"}} name="Fourier forecast"/>
              <Line type="monotone" dataKey="lagFc" stroke={C.blue} strokeWidth={2.5} dot={{r:4,fill:C.blue}} name="Business Logic forecast"/>
              <Line type="monotone" dataKey="fourierFc" stroke="#F472B6" strokeWidth={2.5} dot={{r:4,fill:"#F472B6"}} name="Fourier forecast"/>
              <Line type="monotone" dataKey="prophetFc" stroke={C.teal} strokeWidth={2.5} dot={{r:4,fill:C.teal}} name="Prophet forecast"/>
              <Line type="monotone" dataKey="sarimaFc" stroke={C.amber} strokeWidth={2.5} dot={{r:4,fill:C.amber}} name="ARIMA forecast"/>
              <Line type="monotone" dataKey="naiveFc" stroke={C.purple} strokeWidth={1.5} strokeDasharray="4 4" dot={{r:3,fill:C.purple}} opacity={0.5} name="Naive (ref only)"/>
              <ReferenceLine y={0} stroke={C.red} strokeDasharray="4 4"/>
              <ReferenceLine x="2027-01" stroke={C.grid} strokeDasharray="6 3"/>
            </ComposedChart>
          </ResponsiveContainer>
        </div>

        {/* Forecast detail */}
        <div style={{background:C.bg2,borderRadius:8,padding:14,marginBottom:10}}>
          <div style={{fontSize:11,fontWeight:600,marginBottom:4}}>3-Month Forecast Detail</div>
          <div style={{fontSize:10,color:C.sub,marginBottom:8,fontStyle:"italic"}}>Seasonal Naive shown as reference only — excluded from formal comparison (evaluated on months 13–24 only, unequal window)</div>
          <table style={{width:"100%",borderCollapse:"collapse",fontSize:11}}>
            <thead><tr style={{borderBottom:`1px solid ${C.grid}`}}>
              <th style={{textAlign:"left",padding:"5px 8px",color:C.sub}}>Month</th>
              {models.map(m=><th key={m.key} style={{textAlign:"right",padding:"5px 8px",color:m.color}}>{m.label}</th>)}
              <th style={{textAlign:"right",padding:"5px 8px",color:C.purple,opacity:0.5}}>Naive (ref)</th>
            </tr></thead>
            <tbody>
              {["2027-01","2027-02","2027-03"].map((d,i)=>(
                <tr key={d} style={{borderBottom:`1px solid ${C.grid}`}}>
                  <td style={{padding:"5px 8px",fontWeight:600}}>{d}</td>
                  {models.map(m=>(
                    <td key={m.key} style={{textAlign:"right",padding:"5px 8px",color:m.fc[i]<0?C.red:m.color}}>
                      {fmtFull(m.fc[i])}
                    </td>
                  ))}
                  <td style={{textAlign:"right",padding:"5px 8px",color:C.purple,opacity:0.5}}>{fmtFull(naiveRef.fc[i])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div style={{background:C.bg2,borderRadius:8,padding:12,fontSize:11,color:C.sub,lineHeight:1.7}}>
          <strong style={{color:C.text}}>The model hierarchy holds on both in-sample and out-of-sample evaluation.</strong> Business Logic wins on every metric, including OOS MAE (€24k) and crisis-month bias (-€71k pessimistic, the correct direction for early warning).
          <br/><br/>
          <strong style={{color:C.blue}}>Business Logic (F1=1.000):</strong> Parameters from Coface and IDB benchmarks. That's external data, not "no data." The benchmarks transfer well here, but if the business operates in a niche with different margins, the advantage narrows. The only model with pessimistic bias on crisis months.
          <br/><br/>
          <strong style={{color:"#F472B6"}}>Fourier Regression (F1=0.571):</strong> Structure by AIC (t + F12 + F6); 6 params by OLS. Apr/May binary dummies tested alongside Fourier terms to capture the sharp crisis shape directly; AIC did not support the extra parameters at n=24. Optimistic on crisis months by €128k.
          <br/><br/>
          <strong style={{color:C.teal}}>Prophet (F1=0.857):</strong> Best data-driven model. Fourier order reduced from 10 to 3 to fix overfitting. Still optimistic on crisis months by €112k.
          <br/><br/>
          <strong style={{color:C.amber}}>ARIMA(1,0,2) vs SARIMA diagnostic:</strong> The original SARIMA(0,0,1)(0,0,1)₁₂ had R²=-0.109 and 3 false alarms. Dropping the seasonal MA term (which needed more than 2 cycles) and fitting ARIMA(1,0,2) cut MAE by 30% and eliminated all false alarms. 24 observations is enough for ARIMA. It was not enough for the seasonal layer.
          <br/><br/>
          <strong style={{color:C.sub,fontStyle:"italic"}}>Metrics exclude Jan–Feb 2025 (backfilled months). OOS F1 is undefined because all 4 crisis months fall within the training window of the rolling CV. With more data, OOS crisis detection becomes testable.</strong>
        </div>
      </div>)}

      {/* STEP 6 */}
      {step===6&&(<div>
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(130px,1fr))",gap:8,marginBottom:14}}>
          <Metric label="Safety Buffer (p10)" value="€-84k" sub="10th percentile historical"/>
          <Metric label="Lag Proj. Jan '27" value="€199k" sub="Positive — no alert"/>
          <Metric label="All models Feb '27" value="Thinning" sub="€35k–€292k" warn/>
          <Metric label="Models agree" value="Mar '27 risk" sub="CIs include negative" warn/>
        </div>

        <div style={{background:C.bg2,borderRadius:8,padding:14,marginBottom:10}}>
          <div style={{fontSize:12,fontWeight:600,marginBottom:10}}>Alert Board — Jan to Mar 2027</div>
          <table style={{width:"100%",borderCollapse:"collapse",fontSize:11}}>
            <thead><tr style={{borderBottom:`1px solid ${C.grid}`}}>
              <th style={{textAlign:"left",padding:"6px 8px",color:C.sub}}>Month</th>
              {models.map(m=><th key={m.key} style={{textAlign:"right",padding:"6px 8px",color:m.color}}>{m.label}</th>)}
              <th style={{textAlign:"right",padding:"6px 8px",color:C.purple,opacity:0.5}}>Naive (ref)</th>
            </tr></thead>
            <tbody>
              {["2027-01","2027-02","2027-03"].map((d,i)=>(
                <tr key={d} style={{borderBottom:`1px solid ${C.grid}`,background:models.some(m=>m.fc[i]<0)?`${C.red}0A`:"transparent"}}>
                  <td style={{padding:"7px 8px",fontWeight:600}}>{d}</td>
                  {models.map(m=>(
                    <td key={m.key} style={{textAlign:"right",padding:"7px 8px",color:m.fc[i]<0?C.red:m.color,fontWeight:m.fc[i]<0?700:400}}>
                      {fmtFull(m.fc[i])} {m.fc[i]<0?"🔴":""}
                    </td>
                  ))}
                  <td style={{textAlign:"right",padding:"7px 8px",color:C.purple,opacity:0.5}}>{fmtFull(naiveRef.fc[i])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div style={{background:C.bg2,borderRadius:8,padding:16,marginBottom:10,borderLeft:`3px solid ${C.amber}`}}>
          <div style={{fontSize:14,fontWeight:700,color:C.amber,marginBottom:8}}>Monday Morning Rule</div>
          <div style={{fontSize:12,color:C.text,lineHeight:1.7}}>
            "Cash is thinning across all models through February–March 2027. No model predicts a definitive zero-threshold crisis — but Lag Projection flags January at €199k (thin margin), and all confidence intervals include negative territory by March. You have 2 months. Call your supplier now and negotiate extended terms."
          </div>
        </div>

        <div style={{background:C.bg2,borderRadius:8,padding:12,fontSize:11,color:C.sub,lineHeight:1.6}}>
          <strong style={{color:C.text}}>The alert is a business decision, not a model output.</strong> A €0 buffer catches crises at the last moment. The p10 buffer (€-84k) gives more runway. The right threshold depends on the cost of acting early (a phone call) versus acting late (emergency credit at 18% interest). For VIVA, acting early costs almost nothing. The model should be set accordingly.
        </div>
      </div>)}
    </div>
  );
}
